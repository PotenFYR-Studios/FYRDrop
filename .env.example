# --- Runtime ---
# Port the server listens on (Pterodactyl/Pelican wings inject SERVER_PORT automatically)
PORT=3000
SERVER_PORT=3000

# Directory where the SQLite database, uploads, thumbnails and certificates are stored.
# Mount this as a Docker volume / point it at the egg's /home/container/data.
DATA_DIR=./data

# How long a signed-in device stays signed in (days)
SESSION_TTL_DAYS=30

# Maximum upload size in MiB (also configurable at runtime in Admin → Settings)
MAX_UPLOAD_MB=512

# Worker threads used for thumbnail generation. Keep at 1 on a Raspberry Pi.
THUMB_THREADS=1

# --- HTTP / HTTPS ---
# FYRDrop serves plain HTTP unless told otherwise. The easy way to change it is
# Admin -> Settings -> "HTTP & HTTPS" (see README "HTTP and HTTPS"). A variable
# set here wins over that page and locks the choice.
# 0    = plain HTTP (default). Use it on a trusted network or behind a reverse
#        proxy / Tailscale / Cloudflare Tunnel that provides HTTPS.
# auto = HTTPS with a self-signed certificate generated on first boot.
# TLS_ENABLED=0
# Extra name for the generated certificate (the machine's names and addresses
# are always included):
# TLS_COMMON_NAME=fyrdrop.local
# HTTPS with your own certificate (full chain) and key, PEM, no passphrase:
# TLS_CERT_PATH=/path/to/fullchain.pem
# TLS_KEY_PATH=/path/to/privkey.pem
# With HTTPS on: also listen on this plain-HTTP port and redirect to HTTPS.
# HTTP_REDIRECT_PORT=80

# --- Reverse proxy ---
# Only set to 1 when FYRDrop is behind a proxy you control: it makes the server
# trust X-Forwarded-For / X-Forwarded-Proto. Leaving it at 0 stops clients from
# spoofing their IP (and bypassing rate limits / the IP whitelist).
TRUST_PROXY=0

# Address other instances should use to reach this one (discovery beacons).
# Set this when running in Docker with a published port, otherwise the beacon
# advertises the container IP (172.17.x.x), which peers cannot reach.
# CLUSTER_URL=https://fyrdrop.example.com
