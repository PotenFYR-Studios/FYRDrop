{
  "name": "fyrdrop",
  "version": "1.0.0",
  "description": "Self-hosted sharing hub: files, text, image gallery and self-signed certificates, protected by a PIN.",
  "module": "src/server/index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "bun src/server/index.ts",
    "compile": "bun run build && bun build --compile src/server/index.ts --outfile dist/bin/fyrdrop",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.1.1",
    "drizzle-orm": "^0.36.3",
    "hono": "^4.6.14",
    "node-forge": "^1.3.1",
    "nodemailer": "6.9.16",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "13.1.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/bun": "^1.2.0",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.28.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
